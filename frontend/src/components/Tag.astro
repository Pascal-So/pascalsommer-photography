---
interface Props {
  text: string;
  url: string;
  active: boolean;
}

const { text, url, active } = Astro.props;
---

<a href={url} class={active ? "active" : ""}>
  {text}
</a>

<style>
  a,
  a:visited {
    color: #89b;
  }

  a {
    background-color: #2c2c32;
    border-radius: 3px;
    display: inline-block;
    margin: 0 3px 3px 1px;
    padding: 5px 7px;
    font-size: 0.8rem;
  }

  a.active {
    background-color: #5c5c67;
    color: #19191c;
  }
</style>
