---
import { Image } from "astro:assets";
import { getCollection } from "astro:content";

import { formatDate } from "../utils.ts";
import Layout from "../layouts/Layout.astro";
import ExternalPlatformIconLink from "../components/ExternalPlatformIconLink.astro";
import SoundCloud from "../assets/soundcloud.svg";
import GitHub from "../assets/github.svg";

const posts = (await getCollection("posts")).sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf(),
);
---

<Layout>
  <h1 class="mt-10">Pascal Sommer</h1>
  <h3 class="subheading">— Photography —</h3>
  <div class="mb-8 text-center">
    <ExternalPlatformIconLink link={"https://soundcloud.com/pascal-sommer"}
      ><SoundCloud /></ExternalPlatformIconLink
    >
    <ExternalPlatformIconLink
      link={"https://github.com/Pascal-So/pascalsommer-photography/"}
      ><GitHub /></ExternalPlatformIconLink
    >
  </div>

  {
    posts.map((post) => (
      <div>
        <h2 class="mt-5">
          <a href={`/post/${post.id}`} title="permalink">
            #
          </a>{" "}
          {post.data.name} - {formatDate(post.data.date)}
        </h2>

        {post.data.photos.map((photo) => (
          <>
            <a
              href={`/photos/${photo.id}`}
              title={photo.description}
              class="photo"
            >
              <Image src={photo.img} alt={photo.description} />
            </a>
            <br />
          </>
        ))}
      </div>
    ))
  }
</Layout>

<style>
  .photo {
    max-width: 900px;
    max-height: 900px;
    margin: 5px 0 40px;
    display: inline-block;
    border: 2px solid #0000;
  }

  .photo:hover {
    border-color: #666;
  }

  h2,
  h2 a {
    font-size: 1.2rem;
  }
  h1 {
    font-size: 1.3rem;
  }

  .subheading {
    font-size: 0.8rem;
    color: #666;
    display: inline;
    position: relative;
    top: -5px;
  }

  @media (max-width: 1300px) {
    .photo {
      margin-bottom: 20px;
    }
  }

  @media (max-width: 1000px) {
    .photo {
      max-width: 700px;
      max-height: 700px;
      margin-bottom: 10px;
    }
  }

  @media (max-width: 740px) {
    .photo {
      max-width: 500px;
      max-height: 500px;
      margin-bottom: 5px;
    }

    h2,
    h2 a {
      font-size: 1rem;
    }
    h1 {
      font-size: 1.1rem;
    }
  }

  @media (max-width: 539px) {
    .photo {
      max-width: 430px;
      max-height: 430px;
    }
  }

  @media (max-width: 469px) {
    .photo {
      max-width: 300px;
      max-height: 300px;
    }
  }
</style>
