---
import { getCollection } from "astro:content";

import { postsPerPage } from "../../constants.ts";
import Layout from "../../layouts/Layout.astro";

export async function getStaticPaths() {
  const posts = (await getCollection("posts")).sort(
    (a, b) => b.data.date.valueOf() - a.data.date.valueOf(),
  );

  return posts.map((post, idx) => ({ params: { id: post.id }, props: {page: Math.floor(idx / postsPerPage) + 1 } }));
}

const { page } = Astro.props;
const { id } = Astro.params;
const target = `/page/${page}#post-${id}`;
---

<Layout>
  <div id="redirect-content" data-target={target}></div>
</Layout>

<script>
  const el = document.getElementById("redirect-content")!;
  const target = el.dataset.target!;
  const loc = document.location;
  const link = `${loc.protocol}//${loc.host}${target}`;
  el.innerHTML = `redirecting to post <a href="${link}">${link}</a>...`;
  window.location.replace(link);
</script>
