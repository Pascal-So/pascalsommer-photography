---
import { getCollection, getEntries } from "astro:content";
import { Image } from "astro:assets";

import {
  nl2br,
  formatDate,
  serializePlain,
  parseDescription,
  escapeHtml,
} from "../../utils.ts";
import Layout from "../../layouts/Layout.astro";
import Left from "../../assets/left.svg";
import Right from "../../assets/right.svg";
import ArrowPlaceholder from "../../assets/arrow_placeholder.svg";
import Tag from "../../components/Tag.astro";
import Comments from "../../components/Comments.tsx";

export async function getStaticPaths() {
  const posts = (await getCollection("posts")).sort(
    (a, b) => b.data.date.valueOf() - a.data.date.valueOf(),
  );
  // We don't need to sort photos within a post because the input to the
  // astro collection system already deals with sorting.
  const photos = posts.flatMap((post) =>
    post.data.photos.map((photo) => [photo, post] as const),
  );

  return photos.map(([photo, post], idx) => {
    // We use the fact that out of bounds access returns undefined instead
    // of erroring as a compact way of denoting that the last photo does
    // not have an older photo. Needs manual type assertions because
    // typescript does not care about soundness.
    const previousPhotoId = photos[idx - 1]?.[0]?.id as number | undefined;
    const nextPhotoId = photos[idx + 1]?.[0]?.id as number | undefined;
    return {
      params: { id: photo.id.toString() },
      props: {
        photo,
        post,
        previousPhotoId,
        nextPhotoId,
      },
    };
  });
}

const { photo, post, previousPhotoId, nextPhotoId } = Astro.props;

const tags = await getEntries(photo.tags);

const parsedDescription = parseDescription(photo.description);

const permalink = `/photos/${photo.id}`;
---

<Layout>
  <h2 class="text-lg mb-2">
    <a href={permalink} title="permalink">#</a>
    <a href={`/post/${post.id}`} class="stealth-link">
      {post.data.name} - {formatDate(post.data.date)}</a
    >
  </h2>

  <div class="flex flex-row items-center justify-center">
    {
      previousPhotoId === undefined ? (
        <span class="nav-arrow">
          <ArrowPlaceholder />
        </span>
      ) : (
        <a
          href={`/photos/${previousPhotoId}`}
          class="nav-arrow"
          data-shortcut-key="ArrowLeft"
          title="shortcut: left arrow"
        >
          <Left />
        </a>
      )
    }
    <a href={photo.img.src} target="_blank">
      <Image
        class="photo"
        src={photo.img}
        alt={serializePlain(parsedDescription)}
        priority
        quality={85}
      />
    </a>
    {
      nextPhotoId === undefined ? (
        <span class="nav-arrow">
          <ArrowPlaceholder />
        </span>
      ) : (
        <a
          href={`/photos/${nextPhotoId}`}
          class="nav-arrow"
          data-shortcut-key="ArrowRight"
          title="shortcut: right arrow"
        >
          <Right />
        </a>
      )
    }
  </div>

  <div class="description-area">
    <div class="description card">
      <span>
        <a href={permalink} title="permalink">Photo {photo.id}</a>
        {
          parsedDescription.map((el) => {
            if (typeof el === "string") {
              return <span set:html={nl2br(escapeHtml(el))} />;
            } else if (el.linktype === "coords") {
              const link = `https://www.google.com/maps/?q=${el.latlng}&=Search%20Google%20Maps`;
              return <a href={link}>{el.latlng}</a>;
            } else if (el.linktype === "photo") {
              return <a href={`/photos/${el.id}`}>{el.id}</a>;
            } else {
              return <a href={`/post/${el.id}`}>{el.id}</a>;
            }
          })
        }
      </span>

      <div class="tags">
        {
          tags.map((tag) => (
            <Tag text={tag.id} url={`/tag/${tag.id}`} active={false} />
          ))
        }
      </div>
    </div>

    <Comments
      client:only="react"
      backendUrl={import.meta.env.BACKEND_URL}
      photo={photo.id}
    />
  </div>

  <p class="mb-32">
    Go to a <a href="/photos/random" data-shortcut-key="r" title="shortcut: r">
      random photo</a
    >.
  </p>
</Layout>

<script src="../../keyboardNavigation.ts"></script>

<style>
  .tags {
    display: flex;
    flex-direction: column;
    align-items: end;
    flex-shrink: 0;
  }

  .description-area {
    width: 84vw;
    max-width: 600px;
    margin: auto;
    margin-top: 15px;
    margin-bottom: 10px;
  }

  .description {
    display: flex;
    flex-direction: row;
    gap: 8px;

    margin-bottom: 15px;
  }

  .photo {
    max-width: 84vw;
    max-height: 80vh;
    width: auto;
    height: auto;
    border-radius: 4px;
  }

  .nav-arrow {
    padding: 80px 30px;
    margin-left: 10px;
  }

  .nav-arrow:first-of-type {
    padding-left: 45px;
  }
  .nav-arrow:last-of-type {
    padding-right: 45px;
  }

  .nav-arrow > svg {
    width: 22px;
    display: inline;
  }

  @media (max-width: 1350px) {
    .nav-arrow {
      padding: 80px 21px;
      margin-left: 0px;
    }
  }

  @media (max-width: 700px) {
    .nav-arrow {
      padding: 60px 2vw;
    }

    .nav-arrow > svg {
      width: 3vw;
    }
  }
</style>
