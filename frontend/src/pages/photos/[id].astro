---
import { getCollection } from 'astro:content';
import { Image } from 'astro:assets';

import {formatDate} from '../../utils.ts';
import Layout from '../../layouts/Layout.astro';
import Left from '../../assets/left.svg';
import Right from '../../assets/right.svg';
import ArrowPlaceholder from '../../assets/arrow_placeholder.svg';

export async function getStaticPaths() {
  const posts = await getCollection('posts');
  return posts.flatMap(post => post.data.photos.map(photo => (
    { params: { id: photo.id.toString() }}
  )));
}

const { id } = Astro.params;

const posts = (await getCollection('posts')).sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf()
);

// the term "Idx" here is used as index in the given array order, which is
// separate from the id.
const postIdx = posts.findIndex(post =>
  post.data.photos.findIndex(photo => photo.id.toString() === id) !== -1
);
const post = posts[postIdx];
const photoIdx = post.data.photos.findIndex(photo => photo.id.toString() == id);
const photo = post.data.photos[photoIdx];

// find previous photo
let previousPhotoId: string | null = null;
if (photoIdx > 0) {
  previousPhotoId = post.data.photos[photoIdx - 1].id.toString();
} else if (postIdx > 0) {
  const prevPhotos = posts[postIdx - 1].data.photos;
  previousPhotoId = prevPhotos[prevPhotos.length - 1].id.toString();
}

// find next photo
let nextPhotoId: string | null = null;
if (photoIdx < post.data.photos.length - 1) {
  nextPhotoId = post.data.photos[photoIdx + 1].id.toString();
} else if (postIdx < posts.length - 1) {
  nextPhotoId = posts[postIdx + 1].data.photos[0].id.toString();
}
---

<Layout>
  <h2 class="text-lg"><a href="" title="permalink">#</a> {post.data.name} - {formatDate(post.data.date)}</h2>

  <div class="flex flex-row items-center justify-center">
  
    { previousPhotoId === null
      ? <span class="nav-arrow"><ArrowPlaceholder/></span>
      : <a href={`/photos/${previousPhotoId}`} class="nav-arrow"><Left /></a>
    }
    <a href={photo.img.src} target="_blank"><Image src={photo.img} alt={photo.description}/></a>
    { nextPhotoId === null
      ? <span class="nav-arrow"><ArrowPlaceholder/></span>
      : <a href={`/photos/${nextPhotoId}`} class="nav-arrow"><Right /></a>
    }

  </div>
</Layout>

<style>
.nav-arrow {
  padding: 60px 12px;
}

.nav-arrow>svg {
  width: 18px;
  display: inline;
}
</style>
