---
import { getCollection, getEntries } from "astro:content";
import { Image } from "astro:assets";

import { formatDate, serializePlain, parseDescription } from "../../utils.ts";
import Layout from "../../layouts/Layout.astro";
import Left from "../../assets/left.svg";
import Right from "../../assets/right.svg";
import ArrowPlaceholder from "../../assets/arrow_placeholder.svg";
import Tag from "../../components/Tag.astro";

export async function getStaticPaths() {
  const posts = await getCollection("posts");
  return posts.flatMap((post) =>
    post.data.photos.map((photo) => ({ params: { id: photo.id.toString() } })),
  );
}

const { id } = Astro.params;

const posts = (await getCollection("posts")).sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf(),
);

// the term "Idx" here is used as index in the given array order, which is
// separate from the id.
const postIdx = posts.findIndex(
  (post) =>
    post.data.photos.findIndex((photo) => photo.id.toString() === id) !== -1,
);
const post = posts[postIdx];
const photoIdx = post.data.photos.findIndex(
  (photo) => photo.id.toString() == id,
);
const photo = post.data.photos[photoIdx];

// find previous photo
let previousPhotoId: string | null = null;
if (photoIdx > 0) {
  previousPhotoId = post.data.photos[photoIdx - 1].id.toString();
} else if (postIdx > 0) {
  const prevPhotos = posts[postIdx - 1].data.photos;
  previousPhotoId = prevPhotos[prevPhotos.length - 1].id.toString();
}

// find next photo
let nextPhotoId: string | null = null;
if (photoIdx < post.data.photos.length - 1) {
  nextPhotoId = post.data.photos[photoIdx + 1].id.toString();
} else if (postIdx < posts.length - 1) {
  nextPhotoId = posts[postIdx + 1].data.photos[0].id.toString();
}

const tags = await getEntries(photo.tags);

const parsedDescription = parseDescription(photo.description);
---

<Layout>
  <h2 class="text-lg mb-2">
    <a href={`/photos/${id}`} title="permalink">#</a>
    <a href={`/post/${post.id}`} class="stealth-link">
      {post.data.name} - {formatDate(post.data.date)}</a
    >
  </h2>

  <div class="flex flex-row items-center justify-center">
    {
      previousPhotoId === null ? (
        <span class="nav-arrow">
          <ArrowPlaceholder />
        </span>
      ) : (
        <a href={`/photos/${previousPhotoId}`} class="nav-arrow">
          <Left />
        </a>
      )
    }
    <a href={photo.img.src} target="_blank">
      <Image
        class="photo"
        src={photo.img}
        alt={serializePlain(parsedDescription)}
        priority
        quality={97}
      />
    </a>
    {
      nextPhotoId === null ? (
        <span class="nav-arrow">
          <ArrowPlaceholder />
        </span>
      ) : (
        <a href={`/photos/${nextPhotoId}`} class="nav-arrow">
          <Right />
        </a>
      )
    }
  </div>

  <div class="description">
    <span>
      <span class="underline decoration-dotted">Photo {photo.id}</span>:
      {parsedDescription.map(el => {
        if (typeof(el) === "string") {
          return el;
        } else if (el.linktype === "coords") {
          return el.latlng; // todo
        } else if (el.linktype === "photo") {
          return <a href={`/photos/${el.id}`}>{el.id}</a>;
        } else {
          return <a href={`/post/${el.id}`}>{el.id}</a>;
        }
      })}
    </span>

    <div class="tags">
      {
        tags.map((tag) => (
          <Tag text={tag.id} url={`/tag/${tag.id}`} active={false} />
        ))
      }
    </div>
  </div>
</Layout>

<style>
  .tags {
    display: flex;
    flex-direction: column;
    align-items: end;
    flex-shrink: 0;
  }

  .description {
    display: flex;
    flex-direction: row;
    gap: 8px;
    justify-content: space-between;

    width: 84vw;
    max-width: 600px;
    margin: auto;
    margin-top: 15px;
    margin-bottom: 50px;

    border: 1px solid #444;
    border-radius: 4px;

    padding: 10px;

    hyphens: auto;
    text-align: left;
  }

  .photo {
    max-width: 84vw;
    max-height: 80vh;
    width: auto;
    height: auto;
    border-radius: 4px;
  }

  .nav-arrow {
    padding: 80px 30px;
    margin-left: 10px;
  }

  .nav-arrow:first-of-type {
    padding-left: 45px;
  }
  .nav-arrow:last-of-type {
    padding-right: 45px;
  }

  .nav-arrow > svg {
    width: 22px;
    display: inline;
  }

  @media (max-width: 1350px) {
    .nav-arrow {
      padding: 80px 21px;
      margin-left: 0px;
    }
  }

  @media (max-width: 700px) {
    .nav-arrow {
      padding: 60px 2vw;
    }

    .nav-arrow > svg {
      width: 3vw;
    }
  }
</style>
