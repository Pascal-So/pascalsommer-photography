---
import { Image } from "astro:assets";
import { getCollection } from "astro:content";
import type { GetStaticPathsOptions } from "astro";

import { formatDate } from "../utils.ts";
import Layout from "../layouts/Layout.astro";
import ExternalPlatformIconLink from "../components/ExternalPlatformIconLink.astro";
import PaginationNav from "../components/PaginationNav.astro";
import SoundCloud from "../assets/soundcloud.svg";
import GitHub from "../assets/github.svg";

// In general we're just using the `paginate` helper to generate pages of the
// form /page/n where n is in 1.., but at the same time we want the home page
// at / to also show the same content as /page/1. We do this by manually
// modifying the output of `paginate`, which is kinda ugly.
export async function getStaticPaths({ paginate }: GetStaticPathsOptions) {
  const posts = (await getCollection("posts")).sort(
    (a, b) => b.data.date.valueOf() - a.data.date.valueOf(),
  );

  function moveToPagePath(url: string): string {
    if (url === "/") {
      return "/page/1";
    } else {
      return "/page/" + url.replace("/", "");
    }
  }

  let pages = paginate(posts, { pageSize: 10 });
  let firstPage = undefined;
  for (let page of pages) {
    // change the pages to be located under /page/5 as opposed to /5

    const url = page.props.page.url;
    url.current = moveToPagePath(url.current);
    url.first = url.first && moveToPagePath(url.first);
    url.last = url.last && moveToPagePath(url.last);
    url.next = url.next && moveToPagePath(url.next);
    url.prev = url.prev && moveToPagePath(url.prev);

    if (page.params.page === undefined) {
      firstPage = {...page};
      firstPage.params = { page: "/" };
      page.params.page = "/page/1";
    } else {
      page.params.page = moveToPagePath(page.params.page);
    }
  }
  if (firstPage !== undefined) {
    pages = [firstPage, ...pages]
  }

  return pages;
}

const { page } = Astro.props;
const showTopNav = Astro.params.page?.includes("page");
---

<Layout>
  <a href="/"><h1 class="mt-10">Pascal Sommer</h1></a>
  <h3 class="subheading">— Photography —</h3>
  <div class="mb-8 text-center">
    <ExternalPlatformIconLink link={"https://soundcloud.com/pascal-sommer"}
      ><SoundCloud /></ExternalPlatformIconLink
    >
    <ExternalPlatformIconLink
      link={"https://github.com/Pascal-So/pascalsommer-photography/"}
      ><GitHub /></ExternalPlatformIconLink
    >
  </div>

  {
    showTopNav && (
      <>
        <PaginationNav
          current={page.currentPage}
          total={page.lastPage}
          urls={page.url}
        />
        <br />
      </>
    )
  }

  {
    page.data.map((post) => (
      <div>
        <h2 class="mt-5">
          <a href={`/post/${post.id}`} title="permalink">
            #
          </a>{" "}
          {post.data.name} - {formatDate(post.data.date)}
        </h2>

        {post.data.photos.map((photo) => (
          <>
            <a
              href={`/photos/${photo.id}`}
              title={photo.description}
              class="photo"
            >
              <Image src={photo.img} alt={photo.description} />
            </a>
            <br />
          </>
        ))}
      </div>
    ))
  }

  <PaginationNav
    current={page.currentPage}
    total={page.lastPage}
    urls={page.url}
  />
</Layout>

<style>
  .photo {
    max-width: 900px;
    max-height: 900px;
    margin: 5px 0 40px;
    display: inline-block;
    border: 2px solid #0000;
  }

  .photo:hover {
    border-color: #666;
  }

  h2,
  h2 a {
    font-size: 1.2rem;
  }
  h1 {
    font-size: 1.3rem;
  }

  .subheading {
    font-size: 0.8rem;
    color: #666;
    display: inline;
    position: relative;
    top: -5px;
  }

  @media (max-width: 1300px) {
    .photo {
      margin-bottom: 20px;
    }
  }

  @media (max-width: 1000px) {
    .photo {
      max-width: 700px;
      max-height: 700px;
      margin-bottom: 10px;
    }
  }

  @media (max-width: 740px) {
    .photo {
      max-width: 500px;
      max-height: 500px;
      margin-bottom: 5px;
    }

    h2,
    h2 a {
      font-size: 1rem;
    }
    h1 {
      font-size: 1.1rem;
    }
  }

  @media (max-width: 539px) {
    .photo {
      max-width: 430px;
      max-height: 430px;
    }
  }

  @media (max-width: 469px) {
    .photo {
      max-width: 300px;
      max-height: 300px;
    }
  }
</style>
